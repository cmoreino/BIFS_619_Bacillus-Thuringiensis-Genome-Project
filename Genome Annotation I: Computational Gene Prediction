# Install Glimmer, Barrnap, Prodigal packages

  sudo apt install tigr-glimmer barrnap prodigal

# Create a new directory

  cd ~/Bthuringiensis/
  mkdir 02_annotations
  cd 02_annotations

# Copy the scaffolds data to the new directory

  cp ~/Bthuringiensis/01_spades/assembly/scaffolds.fasta

# Perform gene prediction (structual genome annotation) using prodigal

  prodigal -i ~/Bthuringiensis/01_spades/assembly/scaffolds.fasta \
  -o prodigal.out \
  -s prodigal_table.out \
  -f gff \
  -d prodigal_geneseqs.out \
  -a prodigal_translated.out

# Run Glimmer to identify the long ORFs

  tigr-glimmer long-orfs -n -t 1.15 \
  ~/Bthuringiensis/01_spades/assembly/scaffolds.fasta \
  glimmer.longorfs

# Create the training subset of the long ORF data

  tigr-glimmer extract -t \
  ~/Bthuringiensis/01_spades/assembly/scaffolds.fasta \
  glimmer.longorfs > glimmer.train

# Use the training set to create the HMM model

  tigr-glimmer build-icm -r glimmer.icm 

# Predict gene with the HMM model

  tigr-glimmer glimmer3 -o50 -g110 -t30 \
  ~/Bthuringiensis/01_spades/assembly/scaffolds.fasta \
  glimmer.icm glimmer

# Use Barrnap to find ribosomal RNA genes

  barrnap --threads 4 --kingdom bac scaffolds.fasta > rrna.gff

# Install Anaconda 

  wget https://repo.anaconda.com/archive/Anaconda3-2026.07-1-Linux-x86_64.sh

# Run the Anaconda

  bash Anaconda3-2026.07-1-Linux-x86_64.sh

# Update Ubuntu's package registries

  sudo apt update

# Create a sandbox environment and install Prokka

  conda create -y -n prokka_env -c conda-forge -c bioconda prokka

# Confirm the new environment

  conda env list

# Activate prokka environment

  conda activate prokka_env

# Run Prokka

  prokka scaffolds.fasta

# Confirm the output files

  cd PROKKA

  ls -al



