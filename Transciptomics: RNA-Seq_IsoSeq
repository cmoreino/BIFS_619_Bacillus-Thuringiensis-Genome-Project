# Only expression level differences between two time points will be explored here.

# Create a new folder
cd ~/Bthuringiensis/
mkdir 03_RNASEQ

# Change directory
cd 03_RNASEQ

# Download the first two fastq files from https://www.ebi.ac.uk/ena/browser/view/PRJNA170972 
wget -nc ftp://ftp.sra.ebi.ac.uk/vol1/fastq/SRR524/SRR524792/SRR524792.fastq.gz
wget -nc ftp://ftp.sra.ebi.ac.uk/vol1/fastq/SRR524/SRR524793/SRR524793.fastq.gz

# Install minimap2 to map the reads to a reference gene
sudo apt install minimap2

# Obtain the reference genome
wget https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/161/495/GCF_000161495.1_ASM16149v1/GCF_000161495.1_ASM16149v1_genomic.fna.gz

# Uncompress the downloaded reference genome and rename
gunzip -c GCF_000161495.1_ASM16149v1_genomic.fna.gz > Bthuringiensis.fasta

# Use minimap2 to align the fastq files
minimap2 -ax sr Bthuringiensis.fasta  SRR524792.fastq > Bt1.sam
minimap2 -ax sr Bthuringiensis.fasta  SRR524793.fastq > Bt2.sam

# Install samtools
sudo apt install samtools

# Convert the sam files to bam files
samtools view -b Bt1.sam > Bt1.bam
samtools view -b Bt2.sam > Bt2.bam

# Sort the bam files
samtools sort Bt1.bam -o Bt1.sorted.bam
samtools sort Bt2.bam -o Bt2.sorted.bam

# Index the sorted bam files
samtools index Bt1.sorted.bam
samtools index Bt2.sorted.bam

# Install cmake and bam-readcount
cd ~
sudo apt install cmake
git clone https://github.com/genome/bam-readcount
cd bam-readcount
cmake .
make
sudo make install

# Download the modified Bthuringiensis_gene_map in the 03_RNASEQ directory
cd ~/Bthuringiensis/03_RNASEQ

# Run bam-readcount without quality filters to get nucleotide counts per position
bam-readcount -w 0 -q 0 -b 0 -f Bthuringiensis.fasta Bt1.sorted.bam > counts.1.txt
bam-readcount -w 0 -q 0 -b 0 -f Bthuringiensis.fasta Bt2.sorted.bam > counts.2.txt

# Extract genomic position ($2) and total coverage depth ($4)
awk '{print $2, $4}' counts.1.txt > simple.counts.1.txt
awk '{print $2, $4}' counts.2.txt > simple.counts.2.txt

# Create the script to map read counts to genes using midpoint coordinates
cat << 'EOF' > genecounts1.sh
#!/bin/bash
touch genecounts1.txt
while read id start stop mid gene;
do
	count=$(grep -w $mid simple.counts.1.txt | awk '{print $2}')
if [[ "$count" == "" ]] ; then 
  count=0
fi
	echo -e "$count\t $gene" >> genecounts1.txt

done < Bthuringiensis_gene_map.txt
EOF

# Make the script executable and run it
chmod +x genecounts1.sh
bash genecounts1.sh

# Create the script to map read counts to genes for the second sample
cat << 'EOF' > genecounts2.sh
#!/bin/bash
touch genecounts2.txt
while read id start stop mid gene;
do
	count=$(grep -w $mid simple.counts.2.txt | awk '{print $2}')
if [[ "$count" == "" ]] ; then 
  count=0
fi
	echo -e "$count\t $gene" >> genecounts2.txt

done < Bthuringiensis_gene_map.txt
EOF

# Make the script executable and run it
chmod +x genecounts2.sh
bash genecounts2.sh

# Combine counts from both timepoints, calculate absolute change, and save the top 10 differential genes
paste genecounts1.txt genecounts2.txt | awk '{diff = $1 - $3; abs_diff = (diff < 0 ? -diff : diff); print abs_diff "\t" $1 "\t" $3 "\t" $2}' | sort -k1,1nr | head -n 10 > Top10_Differential_Genes.txt

# Print the top differential genes to standard output
paste genecounts1.txt genecounts2.txt | awk '{diff = $1 - $3; abs_diff = (diff < 0 ? -diff : diff); print abs_diff "\t" $1 "\t" $3 "\t" $2}' | sort -k1,1nr | head -n 10
